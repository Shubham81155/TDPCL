# Copy to .env (or pass --env-file) and edit. Never commit the real file.
# The values below are DEV-ONLY placeholders.

# --- Required ---
DB_PASSWORD=dev-only-change-me
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-jwt-secret-change-me-before-any-real-deployment

# --- Database ---
DB_NAME=smart_garbage
DB_USER=postgres

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:3000
PUBLIC_FILE_BASE_URL=http://localhost:5000
# Baked into the frontend bundle at build time (rebuild after changing)
REACT_APP_API_URL=http://localhost:5000/api

# --- Ports (host side) ---
FRONTEND_PORT=3000
BACKEND_PORT=5000

# --- Storage ---
STORAGE_PROVIDER=local

# --- Email (optional; needed for password reset mails) ---
EMAIL_SERVICE=
EMAIL_USER=
EMAIL_PASSWORD=
