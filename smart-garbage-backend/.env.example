# Environment Configuration - Smart Garbage Reporting System

# Server
NODE_ENV=development
PORT=5000
HOST=localhost

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_garbage_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET=smart-garbage-images
AWS_REGION=us-east-1

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Email Service (SendGrid or Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Redis (for Bull queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=debug

# API
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
PUBLIC_FILE_BASE_URL=http://localhost:5000

# File Storage (local|s3)
STORAGE_PROVIDER=local

# Geolocation
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
IPSTACK_API_KEY=your_ipstack_api_key_for_ip_geolocation

# Garbage Classifier
PYTHON_EXECUTABLE=python
GARBAGE_MODEL_PATH=../garbage_classifier.h5
# Comma-separated labels in the same order as model outputs
GARBAGE_CLASS_LABELS=garbage_heap,litter,dumping_site

# --- Email / SMTP (see docs/EMAIL.md) ---
# EMAIL_SERVICE: gmail | sendgrid | smtp | none. Placeholder values (your_...) count as "not configured":
# email is then disabled with a single startup warning and nothing is sent.
# Generic SMTP (also works with the local sink: node scripts/dev-smtp-sink.js, or Mailpit):
#   EMAIL_SERVICE=smtp
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025          # default 587
#   SMTP_SECURE=false       # true for implicit TLS (port 465)
#   SMTP_USER=              # optional; no auth when empty
#   SMTP_PASSWORD=          # optional
# From address for all mail (fallback: EMAIL_USER, then no-reply@localhost)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
